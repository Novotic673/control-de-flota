# =====================================================================
# NOVOTIC FLEET — Variables de entorno
# Copia este archivo a .env (local) o cárgalas en Vercel → Settings → Environment Variables
# =====================================================================

# --- Base de datos (PostgreSQL) ---------------------------------------
# Neon: usa la URL "pooled" (host con -pooler) para la app…
DATABASE_URL="postgresql://usuario:clave@host/novotic_fleet?sslmode=require"
# …y la URL directa (sin -pooler) para migraciones. Opcional si usas un solo PostgreSQL.
DIRECT_URL=""
DB_POOL_MAX=5

# --- Autenticación (Auth.js / NextAuth) -------------------------------
# URL pública de la app (en Vercel: https://tu-proyecto.vercel.app o tu dominio)
NEXTAUTH_URL="http://localhost:3000"
# Secreto aleatorio largo:  openssl rand -base64 48
NEXTAUTH_SECRET=""

# --- Almacenamiento de archivos ---------------------------------------
# "database" = fotos/documentos en PostgreSQL (arranque rápido, sin bucket)
# "s3"       = cualquier servicio compatible S3: Cloudflare R2, AWS S3, MinIO, Backblaze B2
STORAGE_DRIVER="database"
S3_ENDPOINT=""                 # R2: https://<account_id>.r2.cloudflarestorage.com  (vacío para AWS)
S3_REGION="auto"               # R2: auto · AWS: us-east-1 / sa-east-1 …
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="false"    # true para MinIO
S3_SSE="true"                  # R2 no requiere SSE explícito: usar "false"
SIGNED_URL_TTL_SECONDS=300     # vigencia de URLs temporales de archivos
FILE_SIGNING_SECRET=""         # opcional (por defecto usa NEXTAUTH_SECRET)
MAX_UPLOAD_MB=4                # Vercel limita el cuerpo de la solicitud a ~4.5 MB

# --- Tareas programadas ------------------------------------------------
# Vercel Cron envía "Authorization: Bearer $CRON_SECRET" a /api/cron/alerts
CRON_SECRET=""

# --- Zona horaria de negocio --------------------------------------------
NEXT_PUBLIC_APP_TIMEZONE="America/Santiago"

# --- Modo demostración (muestra cuentas demo en el login) ----------------
NEXT_PUBLIC_DEMO_MODE="false"
ALLOW_DEMO_SEED="false"        # permite correr el seed demo con NODE_ENV=production

# --- Integraciones de notificación (opcionales) --------------------------
RESEND_API_KEY=""              # Email vía Resend
EMAIL_FROM=""                  # ej: "Novotic Fleet <flota@novotic.cl>"
TEAMS_WEBHOOK_URL=""           # Webhook entrante de un canal de Microsoft Teams
WHATSAPP_TOKEN=""              # Meta WhatsApp Cloud API
WHATSAPP_PHONE_ID=""
WHATSAPP_TEMPLATE=""           # plantilla aprobada con 2 parámetros (título, detalle)
